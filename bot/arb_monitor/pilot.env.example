# Robinhood vault pilot: engine environment (copy to a 0600 file OUTSIDE git, fill the <...> values).
# Used by:  cd bot && python3 -m arb_monitor.run_pilot --env-file /path/pilot.env [--check|--once]
# The file is authoritative: run_pilot and the connectivity check drop every inherited engine variable
# (ARB_*, POLY_*, KALSHI_*, DATABASE_URL, proxies, keys, RPC URLs) that is not set here.
#           python3 -m bot.arb_monitor.scripts.venue_connectivity_check --env-file /path/pilot.env
# Docs: milord/docs/VAULT_PILOT_RUNBOOK.md, milord/docs/ROBINHOOD_VAULT_MIGRATION.md §4.

# ── Mode and isolation from the live Base engine ───────────────────────────────
ARB_FUNDING_CHAIN=robinhood
ARB_EXECUTION_MODE=shadow                 # live only after the owner approves real orders
ARB_SHADOW_CAPITAL_USDC=25                # notional size for shadow sizing (no balances are read)
ARB_SHADOW_MAX_EVAL=10                    # opportunities evaluated on live books per shadow cycle
ARB_PILOT_DATA_DIR=/opt/milord-pilot/data # pilot ledgers; never ~/PolyNotifyBot/data
DATABASE_URL=<postgresql://...the PILOT database, not the live one>
ARB_OPINION_ENABLED=false

# ── Vault (DeployVaultPilot.s.sol manifest: deployments/robinhood-pilot-4663.json) ─
ROBINHOOD_CHAIN_ID=4663
ARB_VAULT_CHAIN_ID=4663
ARB_VAULT_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ARB_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
ARB_VAULT_ASSET=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
ARB_VAULT_DOMAIN_SALT=PMFIArbVaultV3.milord.v1
ARB_VAULT_V2_ADDRESS=<pARBVault from the manifest>
ARB_SERVICER_WALLET=<servicer address = MILORD_SERVICER = address of POLY_PRIVATE_KEY>
ARB_NAV_SIGNER_PRIVATE_KEY=<pilot report signer key = MILORD_REPORT_SIGNER>

# ── Opportunity feed ───────────────────────────────────────────────────────────
ARB_OPPORTUNITY_FEED=compare              # oddpool | prediction_com | compare
ARB_FEED_COMPARE_PRIMARY=oddpool
PREDICTION_COM_API_KEY=<Dev plan or higher; leave empty to stay on Oddpool>
PREDICTION_COM_MIN_POLL_SECONDS=30        # plus pacing from X-RateLimit-Remaining-* headers
PREDICTION_COM_QUOTA_RESERVE=50           # monthly calls kept back for manual checks
ODDPOOL_API_KEY=<existing>

# ── Pilot risk limits (existing engine controls, tightened) ────────────────────
ARB_MAX_PAIR_USDC=25
ARB_MAX_DEPLOYED_USDC=<pilot amount>
ARB_MIN_CONTRACTS=5
ARB_STALE_QUOTE_SECONDS=120
ARB_POLY_EXACT_FEES=true                  # default in robinhood mode
ARB_KALSHI_TIME_IN_FORCE=fill_or_kill     # default

# ── Venues: the PILOT's own accounts ───────────────────────────────────────────
# The engine treats POLY_PRIVATE_KEY's address as the servicer and counts every venue balance in the
# vault's NAV. Sharing the live Base engine's Polymarket or Kalshi account would put the same money
# in two vaults' NAV, so the pilot needs its own Polymarket wallet and its own Kalshi account.
POLY_API_KEY=<>
POLY_API_SECRET=<>
POLY_API_PASSPHRASE=<>
POLY_PRIVATE_KEY=<>
POLY_PROXY_ADDRESS=<Polymarket Safe/proxy wallet>
KALSHI_API_KEY_ID=<>
KALSHI_PRIVATE_KEY_PATH=<path to .pem>
# Public market data (Gamma, CLOB books, Kalshi) goes direct; PROXY_URL is not needed and not used.
# Polymarket order eligibility = the DIRECT geoblock check; a proxy never makes trading available.
ARB_PUBLIC_DATA_ROUTE=direct

# ── Funding routes (B9) ────────────────────────────────────────────────────────
POLY_RH_DEPOSIT_ADDR=<Polymarket bridge deposit address for USDG on 4663>
POLY_RH_DEPOSIT_CHAIN_ID=4663
POLY_RH_DEPOSIT_TOKEN=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
KALSHI_BASE_DEPOSIT_ADDR=<Kalshi USDC deposit address on Base>
KALSHI_BASE_DEPOSIT_CHAIN_ID=8453
KALSHI_BASE_DEPOSIT_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ARB_BRIDGE_ALLOWLIST=<4663:0x...,8453:0x... verified bridge contracts>
ARB_POLY_WITHDRAW_ROUTE=polymarket_bridge
ARB_POLY_BRIDGE_ROUTE_VERIFIED=false      # true only after the approved $10 round trip
# ARB_KALSHI_API_WITHDRAW_VERIFIED stays unset: Kalshi withdrawals are a manual app step
ARB_CTF_ROUTE_VERIFIED=false              # B21 redemption; true after the approved first redemption
