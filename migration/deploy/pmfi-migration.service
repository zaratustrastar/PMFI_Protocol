# REVIEW ONLY. Node 24 must be installed at this path; verify before installation.
[Unit]
Description=PMFI migration API and canonical Base ledger
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=pmfi-migration
Group=pmfi-migration
WorkingDirectory=/opt/pmfi-migration/current
EnvironmentFile=/etc/pmfi-migration/service.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pmfi-migration
[Install]
WantedBy=multi-user.target
