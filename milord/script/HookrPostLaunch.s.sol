pragma solidity 0.8.26;

import {Script, console2} from "forge-std/Script.sol";
import {IPoolManager} from "@uniswap/v4-core/src/interfaces/IPoolManager.sol";
import {IHooks} from "@uniswap/v4-core/src/interfaces/IHooks.sol";
import {PoolKey} from "@uniswap/v4-core/src/types/PoolKey.sol";
import {Currency} from "@uniswap/v4-core/src/types/Currency.sol";
import {IPositionManager} from "@uniswap/v4-periphery/src/interfaces/IPositionManager.sol";
import {V4SwapAdapter} from "../src/launch/V4SwapAdapter.sol";
import {MilordLiquidityLock} from "../src/launch/MilordLiquidityLock.sol";

/// @notice Step after Hookr opens the MILORD/ETH market: deploys the buyback route (V4SwapAdapter over the exact
///         Hookr pool key) and, for the PositionManager path, the permanent liquidity lock. Owner actions (mint the
///         MILORD-only position, BuybackBurner.setInitialAdapter) are Safe transactions generated by
///         offchain/safe-launch-batch.mjs. TESTNET ONLY: refuses Robinhood mainnet (4663).
///
///   Env: MILORD_TOKEN, MILORD_POOL_HOOK (Hookr root hook), MILORD_POOL_FEE (key fee field, e.g. 0x800000 dynamic),
///        MILORD_POOL_TICK_SPACING, V4_POOL_MANAGER, V4_POSITION_MANAGER, MILORD_LP_FEE_RECIPIENT.
contract HookrPostLaunch is Script {
    function run() external returns (V4SwapAdapter route, MilordLiquidityLock lock) {
        require(block.chainid != 4663, "mainnet deployment not approved");
        require(block.chainid == 46630 || block.chainid == 31337, "Robinhood Chain testnet or local only");
        PoolKey[] memory keys = new PoolKey[](1);
        keys[0] = PoolKey({
            currency0: Currency.wrap(address(0)),
            currency1: Currency.wrap(vm.envAddress("MILORD_TOKEN")),
            fee: uint24(vm.envUint("MILORD_POOL_FEE")),
            tickSpacing: int24(int256(vm.envUint("MILORD_POOL_TICK_SPACING"))),
            hooks: IHooks(vm.envAddress("MILORD_POOL_HOOK"))
        });
        vm.startBroadcast();
        route = new V4SwapAdapter(IPoolManager(vm.envAddress("V4_POOL_MANAGER")), keys);
        lock = new MilordLiquidityLock(IPositionManager(vm.envAddress("V4_POSITION_MANAGER")), vm.envAddress("MILORD_LP_FEE_RECIPIENT"));
        vm.stopBroadcast();
        console2.log("V4SwapAdapter", address(route));
        console2.log("MilordLiquidityLock", address(lock));
    }
}
