pragma solidity 0.8.26;

import {Script, console2} from "forge-std/Script.sol";
import {IPoolManager} from "@uniswap/v4-core/src/interfaces/IPoolManager.sol";
import {IHooks} from "@uniswap/v4-core/src/interfaces/IHooks.sol";
import {PoolKey} from "@uniswap/v4-core/src/types/PoolKey.sol";
import {Currency} from "@uniswap/v4-core/src/types/Currency.sol";
import {V4SwapAdapter} from "../src/launch/V4SwapAdapter.sol";
import {HookrLockFeeCollector, IHookrFamilyLock} from "../src/launch/HookrLockFeeCollector.sol";
import {IMILORD} from "../src/interfaces/IMILORD.sol";

/// @notice Step after Hookr's launcher opened the MILORD family: deploys the buyback route (V4SwapAdapter over the
///         exact Hookr pool key) and the LP fee collector that will be the beneficiary of Hookr's launch lock.
///         The lock itself (launcher.transferFamily to HookrFamilyLock, then HookrFamilyLock.lock) and
///         BuybackBurner.setInitialAdapter are Safe transactions generated by offchain/safe-launch-batch.mjs and are
///         NOT executed by this script. TESTNET/LOCAL ONLY: refuses Robinhood mainnet (4663).
///
///   Env: MILORD_TOKEN, MILORD_POOL_HOOK (HookrRoot), MILORD_POOL_FEE (key fee field), MILORD_POOL_TICK_SPACING,
///        V4_POOL_MANAGER, MILORD_FAMILY_ID, MILORD_BUYBACK_BURNER, HOOKR_FAMILY_LOCK.
contract HookrPostLaunch is Script {
    function run() external returns (V4SwapAdapter route, HookrLockFeeCollector collector) {
        require(block.chainid != 4663, "mainnet deployment not approved");
        require(block.chainid == 46630 || block.chainid == 31337, "Robinhood Chain testnet or local only");
        PoolKey[] memory keys = new PoolKey[](1);
        keys[0] = PoolKey({
            currency0: Currency.wrap(address(0)),
            currency1: Currency.wrap(vm.envAddress("MILORD_TOKEN")),
            fee: uint24(vm.envUint("MILORD_POOL_FEE")),
            tickSpacing: int24(int256(vm.envUint("MILORD_POOL_TICK_SPACING"))),
            hooks: IHooks(vm.envAddress("MILORD_POOL_HOOK"))
        });
        IPoolManager pm = IPoolManager(vm.envAddress("V4_POOL_MANAGER"));
        vm.startBroadcast();
        route = new V4SwapAdapter(pm, keys);
        collector = new HookrLockFeeCollector(
            IHookrFamilyLock(vm.envAddress("HOOKR_FAMILY_LOCK")),
            vm.envBytes32("MILORD_FAMILY_ID"),
            IMILORD(vm.envAddress("MILORD_TOKEN")),
            payable(vm.envAddress("MILORD_BUYBACK_BURNER")),
            pm
        );
        vm.stopBroadcast();
        console2.log("V4SwapAdapter", address(route));
        console2.log("HookrLockFeeCollector", address(collector));
    }
}
