# Epoch publisher only. Copy to publisher.env (git-ignored).
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Daily epochs: each root is proposed as soon as the previous one leaves its 1-day review delay, so a short
# interval keeps that moment close to 24 h after the previous proposal.
INTERVAL_SECS=120
# Roots vetoed by the Team Safe that were investigated and may be superseded (comma-separated). Until a vetoed
# root is listed here the publisher proposes nothing new.
#PUBLISHER_ACK_VETOES=
# ShareDistributor publisher key. No other role (DeployRobinhood refuses publisher == keeper).
PUBLISHER_PRIVATE_KEY=
