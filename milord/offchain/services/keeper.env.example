# Keeper only. Copy to keeper.env (git-ignored); in production the key comes from the secret store (OPERATIONS_PLAN.md).
RPC_URL=https://rpc.testnet.chain.robinhood.com
INTERVAL_SECS=300
# Gas-only key; BuybackBurner operator and router keeper. No Safe role. Keep >= 0.05 ETH on it.
KEEPER_PRIVATE_KEY=
MIN_BUYBACK_WEI=10000000000000000
BUYBACK_MAX_BELOW_TWAP_BPS=1000
# Hookr tax queue: pay the creator share once at least this much is due
MIN_TAX_PAYOUT_WEI=1000000000000000
# MILORD/ETH TWAP freshness for the buyback minimum (seconds)
MAX_STALENESS=120
MAX_HEAD_LAG=120
