# Shared, non-secret settings for all four services. Copy to common.env (git-ignored).
CHAIN_ID=46630
# 00:00 UTC of distribution day 1 (unix seconds, a multiple of 86400). Epochs are daily UTC days.
EPOCH_GENESIS=
SETTLEMENT_GRACE_SECS=21600
FINALITY_CONFIRMATIONS=64
# First block to index; defaults to the deployments file's startBlock
#START_BLOCK=
# eth_getLogs window; halved automatically when the RPC refuses a range
LOG_BLOCK_RANGE=10000
# Seconds to wait for a transaction to be mined before alerting and resetting the nonce
TX_TIMEOUT_SECS=180
# Alerts are POSTed as JSON {service, level, key, text, at}. Slack/Discord/PagerDuty webhook or relay.
ALERT_WEBHOOK_URL=
# Refuses Robinhood mainnet (4663) unless set to yes after owner approval.
ALLOW_MAINNET=no
