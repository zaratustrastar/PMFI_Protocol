# Read-only monitor. Copy to monitor.env (git-ignored). No private key.
RPC_URL=https://a-different-provider.example/robinhood-testnet
INTERVAL_SECS=300
# name=address[:minWei]; addresses are public, not secrets
MONITOR_WALLETS=keeper=0x...,publisher=0x...,reporter=0x...,servicer=0x...
# Optional: the arbitrage engine's bridge/transfer status JSON ({rows:[{id,kind,amount,status,startedAt}]})
#BRIDGE_STATUS_URL=http://10.0.0.2:9110/bridges
NAV_MAX_AGE_SECS=7200
PPS_ALERT_BPS=100
FEE_STUCK_SECS=21600
SETTLE_STUCK_SECS=86400
EPOCH_GRACE_SECS=21600
BRIDGE_MAX_SECS=7200
MIN_GAS_WEI=10000000000000000
