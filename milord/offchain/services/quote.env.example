# Quote server only. Copy to quote.env (git-ignored); in production the key comes from the secret store (KMS/HSM preferred).
RPC_URL=https://rpc.testnet.chain.robinhood.com
# The converter's quote signer (MilordConverter.setQuoteSigner). Signs entry quotes only; holds no funds.
QUOTE_SIGNER_PRIVATE_KEY=
# TWAP freshness and the RPC head's maximum lag behind the wall clock (seconds)
MAX_STALENESS=120
MAX_HEAD_LAG=120
