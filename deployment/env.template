# Environment Variables Template for VPS Deployment
# Copy this file to .env and fill in your actual values

# ==================== DATABASE ====================
# Local PostgreSQL on VPS
DATABASE_URL=postgresql://polymarket:YOUR_PASSWORD_HERE@localhost:5432/polymarket_trading
PGHOST=localhost
PGPORT=5432
PGUSER=polymarket
PGPASSWORD=YOUR_PASSWORD_HERE
PGDATABASE=polymarket_trading

# ==================== POLYMARKET TRADING ====================
# Get these from your Polymarket wallet setup
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLYMARKET_PROXY_ADDRESS=0xYOUR_PROXY_WALLET_ADDRESS
POLYMARKET_API_KEY=YOUR_API_KEY_HERE
POLYMARKET_API_SECRET=YOUR_API_SECRET_HERE

# ==================== TELEGRAM BOT ====================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ==================== TWITTER (OPTIONAL) ====================
# Get these from Twitter Developer Portal
TWITTER_API_KEY=YOUR_TWITTER_API_KEY
TWITTER_API_SECRET=YOUR_TWITTER_API_SECRET
TWITTER_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
TWITTER_ACCESS_SECRET=YOUR_ACCESS_SECRET

# ==================== SESSION SECRET ====================
# Generate random string: openssl rand -hex 32
SESSION_SECRET=GENERATE_RANDOM_STRING_HERE

# ==================== AI INTEGRATIONS (OPTIONAL) ====================
# If using Replit AI Integrations
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ==================== RESIDENTIAL PROXY ====================
# If using external residential proxy service
# Format: http://username:password@proxy-host:port
# Leave empty if VPS has residential IP
HTTP_PROXY=
HTTPS_PROXY=

# Example configurations:
# Bright Data:
# HTTP_PROXY=http://customer-USERNAME-cc-us:PASSWORD@brd.superproxy.io:22225
# HTTPS_PROXY=http://customer-USERNAME-cc-us:PASSWORD@brd.superproxy.io:22225

# IPRoyal:
# HTTP_PROXY=http://USERNAME:PASSWORD@geo.iproyal.com:12321
# HTTPS_PROXY=http://USERNAME:PASSWORD@geo.iproyal.com:12321

# NordVPN (using SOCKS5):
# HTTP_PROXY=socks5://USERNAME:PASSWORD@residential.nordvpn.com:1080
# HTTPS_PROXY=socks5://USERNAME:PASSWORD@residential.nordvpn.com:1080
